{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\path\\to\\codex-hackathon\\scripts\\guardsaab_codex_hook.py\"",
            "command_windows": "py -3 \"C:\\path\\to\\codex-hackathon\\scripts\\guardsaab_codex_hook.py\"",
            "timeout": 30,
            "statusMessage": "Checking command with GuardSaaB"
          }
        ]
      }
    ]
  }
}
